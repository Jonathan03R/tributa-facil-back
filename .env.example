PUERTO=3010
# Clave que protege POST /articulos y el acceso a borradores (header x-api-key)
API_KEY_INTERNA=pon-aqui-una-clave-larga
# Supabase SOLO por API con llaves (nunca cadena de conexión Postgres)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Orígenes web autorizados a LEER el API desde un navegador (CORS), separados por comas.
# En producción pon el dominio real de la web. Por defecto solo localhost (Astro dev).
CORS_ORIGENES=http://localhost:4321,http://127.0.0.1:4321
