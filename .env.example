# Copia este archivo como .env y completa los valores. NUNCA subas .env a git.
PUERTO=3010
# Cadena de conexión Postgres de Supabase (Supabase > Project Settings > Database > Connection string, modo URI)
SUPABASE_DB_URL=
# Clave interna: solo Muse (importador) y tú la conocen. Protege POST /articulos.
API_KEY_INTERNA=cambia-esto-por-una-clave-larga
# Carpeta de artículos .json (solo se usa si falta SUPABASE_DB_URL: modo archivos, solo lectura)
CARPETA_ARTICULOS=../articulos
